# Optional. The app has a Settings panel, so a .env is only useful for development.
# Keys entered in the app are encrypted with the OS keychain instead.

# --- Free and private: run the model on your own machine (recommended) ---
LENS_PROVIDER=ollama
LENS_OLLAMA_MODEL=gemma3:12b
# Point this at another machine on your network to use its GPU.
LENS_OLLAMA_URL=http://localhost:11434

# --- Or use a key you already own ---
# LENS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# LENS_PROVIDER=gemini
# GEMINI_API_KEY=

# LENS_PROVIDER=openai
# OPENAI_API_KEY=

# LENS_PROVIDER=groq
# GROQ_API_KEY=

# --- Web search (optional). Falls back to a keyless engine if unset. ---
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
